{
    "name": "vatu/tools",
    "description": "Development tools.",
    "license": "MIT",
    "type": "metapackage",
    "require": {
        "php-stubs/wordpress-stubs": "^6.9.4",
        "php-stubs/wp-cli-stubs": "^2.12.0",
        "phpcompatibility/php-compatibility": "10.0.0-alpha1@dev",
        "phpcompatibility/phpcompatibility-paragonie": "^2.0.0-alpha2@dev",
        "phpcompatibility/phpcompatibility-wp": "^3.0.0-alpha2@dev",
        "vatu/dev-tools": "^2.1.0",
        "wp-coding-standards/wpcs": "^3.3"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.52"
    },
    "repositories": [],
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "normalize": {
            "indent-size": 4,
            "indent-style": "space"
        }
    }
}
