{
    "name": "vatu/project-wordpress",
    "description": "Starter WordPress project from Vatu.",
    "license": "proprietary",
    "type": "project",
    "readme": "https://github.com/vatu-team/project-wordpress/blob/main/readme.md",
    "authors": [
        {
            "name": "Vatu",
            "email": "info@vatu.dev",
            "homepage": "https://vatu.dev",
            "role": "Agency"
        }
    ],
    "homepage": "https://github.com/vatu-team/project-wordpress",
    "support": {
        "issues": "https://github.com/vatu-team/project-wordpress/issues"
    },
    "require": {
        "php": "~8.4.1",
        "composer/installers": "^2.3.0",
        "cweagans/composer-patches": "^2.0.0",
        "humanmade/s3-uploads": "^3.0.13",
        "johnpbloch/wordpress": "^7.0.2",
        "roots/wp-config": "^1.0.0",
        "vlucas/phpdotenv": "^5.6.4",
        "wp-plugin/better-passwords": "^1.8.0",
        "wp-plugin/disable-emojis": "^1.9",
        "wp-plugin/fluent-smtp": "^2.3.0",
        "wp-plugin/safe-svg": "^2.4.0",
        "wp-plugin/two-factor": "^0.16.0",
        "wp-plugin/wordpress-seo": "^28.1",
        "wp-plugin/wp-robots-txt": "^1.3.5"
    },
    "require-dev": {
        "captainhook/captainhook": "^5.29.2",
        "ergebnis/composer-normalize": "^2.52.0",
        "wp-plugin/duplicate-post": "^4.7",
        "wp-plugin/log-deprecated-notices": "^0.4.1",
        "wp-plugin/query-monitor": "^4.0.7",
        "wp-plugin/rewrite-rules-inspector": "^1.6.0",
        "wp-plugin/rewrite-testing": "^0.1.1",
        "wp-plugin/transients-manager": "^2.0.7",
        "wp-plugin/user-switching": "^1.12.1",
        "wp-plugin/wordpress-beta-tester": "^4.0.0",
        "wp-plugin/wordpress-importer": "^0.9.5",
        "wp-plugin/wp-crontrol": "^1.21.0",
        "wp-theme/twentytwentyfive": "^1.5"
    },
    "repositories": [
        {
            "name": "wp-packages",
            "type": "composer",
            "url": "https://repo.wp-packages.org"
        },
        {
            "name": "wpsecadv",
            "type": "composer",
            "url": "https://repo-wpsecadv.typist.tech",
            "only": [
                "wp-plugin/*",
                "wp-theme/*",
                "wp-core/*",
                "johnpbloch/wordpress-core",
                "gravity/*",
                "yoast/*",
                "vatu/*"
            ]
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "captainhook/hook-installer": true,
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "ergebnis/composer-normalize": true,
            "johnpbloch/wordpress-core-installer": true
        },
        "policy": {
            "abandoned": {
                "audit": "report"
            },
            "advisories": {
                "ignore-id": {
                    "CVE-2017-14990": {"reason": "Issue is only present if attacker has comprimised the database."},
                    "CVE-2022-3590": {"reason": "False positive."}
                }
            },
            "malware": {
                "block-scope": "all"
            }
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "installer-paths": {
            "public/app/mu-plugins/{$name}/": [
                "type:wordpress-muplugin"
            ],
            "public/app/plugins/{$name}/": [
                "type:wordpress-plugin"
            ],
            "public/app/themes/{$name}/": [
                "type:wordpress-theme"
            ]
        },
        "normalize": {
            "indent-size": 4,
            "indent-style": "space"
        },
        "patches-file": "patches/composer.patches.json",
        "wordpress-install-dir": "public/wp"
    },
    "scripts": {
        "post-install-cmd": [
            "@composer run tools"
        ],
        "post-update-cmd": [
            "@composer run tools"
        ],
        "post-create-project-cmd": [
            "bin/post-create-project-cmd"
        ],
        "fix": [
            "@composer fix:normalize",
            "@composer fix:standards"
        ],
        "fix:normalize": [
            "@composer normalize"
        ],
        "fix:standards": [
            "./tools/vendor/bin/phpcbf"
        ],
        "test": [
            "@composer test:security",
            "@composer test:lint",
            "@composer test:analysis",
            "@composer test:compatibility",
            "@composer test:unit"
        ],
        "test:analysis": [
            "./tools/vendor/bin/phpstan analyse -c ./phpstan.dist.neon --memory-limit 4G"
        ],
        "test:compatibility": [
            "./tools/vendor/bin/phpcs --colors --report-width=120 --standard=PHPCompatibility --extensions=php --ignore=vendor/* --ignore=tools/* ./config ./public/app/mu-plugins/site-config.php"
        ],
        "test:lint": [
            "@composer validate --ansi --strict",
            "@composer test:lint:syntax",
            "@composer test:lint:standards"
        ],
        "test:lint:standards": [
            "./tools/vendor/bin/phpcs -n"
        ],
        "test:lint:syntax": [
            "./tools/vendor/bin/parallel-lint --exclude */vendor ./config",
            "./tools/vendor/bin/parallel-lint --exclude */vendor ./public/app/mu-plugins/site-config.php"
        ],
        "test:security": [
            "composer audit --locked --ansi"
        ],
        "test:unit": [
            "./tools/vendor/bin/phpunit -c ./phpunit.dist.xml --testsuite unit"
        ],
        "tools": [
            "@composer install --working-dir=tools",
            "@composer run post-install-cmd --working-dir=tools"
        ]
    }
}
