#!/usr/bin/env php
<?php

/**
 * Script run when Composer creates a project.
 */
$script_root = getcwd();
$project_root = dirname( path: __FILE__, levels: 2 );

$config = [
	'project_vendor' => null,
	'project_name' => null,
	'project_repo' => null,
	'project_homepage' => null,
	'project_description' => null,
];

function ask( string $question, bool $required = false, string $answer = '' ): string {
	print_r( "{$question}\n" );
	$handle = fopen('php://stdin', 'r');
	$answer = str_replace( [ "\n", "\r" ], '', fgets( $handle ) );
	fclose($handle);

	if( $required && $answer === '' ) {
		throw new Exception( "Invalid answer." );
	}

	return $answer;
}

function updateComposerConfig( array $config ): void
{
	$command_list = [
		"composer config name '{$config['project_vendor']}/{$config['project_name']}'",
		"composer config description '{$config['project_description']}'",
		// "composer config homepage '{$config['project_homepage']}'",
		"composer config --no-interaction allow-plugins.captinhook/hook-installer true",
		"composer require captainhook/hook-installer --dev  --no-interaction ",
	];

	foreach ( $command_list as $command ) {
		exec( $command );
	}
}

function renameFiles(): void {
	global $project_root;

	$files_to_rename = [
		'readme.md' => 'readme.md.bk',
		'readme-template.md' => 'readme.md',
	];

	if ( file_exists( filename: "{$project_root}/readme-template.md" ) ) {
		foreach( $files_to_rename as $old => $new ) {
			rename(
				from: "{$project_root}/{$old}",
				to: "{$project_root}/{$new}"
			);
		}
	}
}

function deleteFiles(): void {
	global $project_root;

	$files_to_delete = [
		'readme.md.bk',
		'bin/pos-crete-project-cmd',
	];

	foreach( $files_to_delete as $file ) {
		deleteFile( filename: "{$project_root}/{$file}" );
	}
}

function findReplace() {

}

$find_and_replace = [
	[
		'example.md' => [
			'find' => 'text-old',
			'replace' => 'text-new',
		]
	]
];

function deleteFile( string $filename ): bool
{
	if( ! file_exists( filename: $filename ) ) {
		throw new Exception( "Not Found: {$filename}" );
	}
	echo "Deleted `{$filename}`." . "\r\n";
	return unlink( filename: $filename );
}

try {

	$config['project_vendor'] = ask( question: "Choose a Vendor. Eg, Vatu", required: true );
	$config['project_name']   = ask( question: "Choose a Project Name. Eg, Website", required: true );
	// $config['project_homepage'] = ask( question: "Enter a project URL. Eg, https://www.example.test" );
	// $config['project_repo'] = ask( question: "Enter the Git repository URL. Eg, https://github.com/vatu-team/example" );

	updateComposerConfig( config: $config );
	renameFiles();
	deleteFiles();

} catch ( \Exception $exception ) {
	echo $exception->getMessage() . "\r\n";
}

exit();
